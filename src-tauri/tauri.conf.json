{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shift",
  "version": "0.1.6",
  "identifier": "app.nex.shift",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Shift",
        "url": "index.html?view=main",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      },
      {
        "label": "radial",
        "title": "Shift Radial",
        "url": "index.html?view=radial",
        "width": 760,
        "height": 760,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "focus": false,
        "shadow": false,
        "acceptFirstMouse": true
      },
      {
        "label": "capture",
        "title": "Shift Capture",
        "url": "index.html?view=capture",
        "width": 1200,
        "height": 800,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "shadow": false
      },
      {
        "label": "recorder",
        "title": "Shift Recorder",
        "url": "index.html?view=recorder",
        "width": 300,
        "height": 88,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "acceptFirstMouse": true
      },
      {
        "label": "pin",
        "title": "Shift Pin",
        "url": "index.html?view=pin",
        "width": 360,
        "height": 360,
        "minWidth": 120,
        "minHeight": 80,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "acceptFirstMouse": true
      },
      {
        "label": "editor",
        "title": "Shift Editor",
        "url": "index.html?view=editor",
        "width": 1120,
        "height": 780,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Radial file utility, capture and OCR.",
    "longDescription": "Shift brings Tangerine-style radial file actions, CleanShot-style capture, screen recording and local OCR to macOS and Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
